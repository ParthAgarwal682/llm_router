# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NEVER commit .env — only this template belongs in git.

# ── Required ──────────────────────────────────────────────────────────────────

# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes

# ── Auth token lifetimes (optional — defaults shown) ──────────────────────────

# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
# In production, set this to your actual frontend domain(s).
# In development, leave unset — defaults to localhost:3000 and localhost:8000.
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Rate limiting (optional — defaults shown) ─────────────────────────────────
# RATE_LIMIT_RPM=20
# MAX_CONCURRENT_VERIFICATIONS=5

# ── Input limits (optional — defaults shown) ──────────────────────────────────
# MAX_PROMPT_LENGTH=8000
# MAX_CONVERSATION_MESSAGES=200

# ── OpenRouter attribution headers (optional) ─────────────────────────────────
OPENROUTER_HTTP_REFERER=https://github.com/yourusername/llm-router-arbitration
OPENROUTER_APP_TITLE=Smart Router Arbitration

# ── Next.js frontend (set in web/.env.local) ──────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
