# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a key at: https://openrouter.ai/keys
# Never commit .env — only this template belongs in git.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional OpenRouter attribution headers (show up on their rankings)
OPENROUTER_HTTP_REFERER=https://github.com/yourusername/llm-router-arbitration
OPENROUTER_APP_TITLE=Smart Router Arbitration
